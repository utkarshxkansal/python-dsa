   "source": [
    "n = input(\"enter a no\")\n",
    "num = int(n)\n",
    "length = len(n)\n",
    "sum = 0\n",
    "while num>0:\n",
    "    last_no = num%10\n",
    "    sum = sum + last_no**length\n",
    "    num = num//10\n",
    "\n",
    "n = int(n)\n",
    "if(sum == n):\n",
    "    print(\"its armstrong no\")\n",
    "else:\n",
    "    print(\"chutiya katt gya\")\n",
