   "source": [
    "n = int(input(\"Enter a No\"))\n",
    "num = n\n",
    "count = 0\n",
    "while num>0:\n",
    "    count +=1\n",
    "    num = num//10\n",
    "print(count)\n",
    "    \n",
    "\n"
   ]
