   "source": [
    "n = int(input(\"Enter a nO TO MAKE US IF ITS A PLAINDROME OR NOT\"))\n",
    "num = n\n",
    "new_no = 0\n",
    "cum = 0\n",
    "while num>0:\n",
    "    new_no = num%10\n",
    "    cum = cum*10 + new_no\n",
    "    num = num//10\n",
    "\n",
    "if(cum == n):\n",
    "    print(\"number a palindrome\")\n",
    "else:\n",
    "    print(\"chuiya katt gya\")\n",
    "\n",
