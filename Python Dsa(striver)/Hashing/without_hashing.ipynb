   "source": [
    "def count(number,arr):\n",
    "    count = 0\n",
    "    for i in range(0,n):\n",
    "        if(arr[i]==number):\n",
    "            count=count+1\n",
    "    return count\n",
    "\n",
    "\n",
    "\n",
    "arr=[3,4,3,5,1,3,5,67,7,2,4,434,3,3,3,34]\n",
    "n = len(arr)\n",
    "x =int(input(\"enter the no\"))\n",
    "count(x,arr)"
   ]
