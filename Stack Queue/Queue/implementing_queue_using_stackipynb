    "class queue:\n",
    "    def __init__(self):        \n",
    "        self.st1 = []\n",
    "        self.st2 = []\n",
    "\n",
    "    def push(self,x):\n",
    "        while self.st1:\n",
    "            self.st2.append(self.st1.pop())\n",
    "        self.st1.append(x)\n",
    "        while self.st2:\n",
    "            self.st1.append(self.st2.pop())\n",
    "\n",
    "    def display(self):\n",
    "        print(self.st1)\n",
    "        \n",
    "\n",
    "        \n",
    "    "
   ]
