   "source": [
    "# hashing of strings \n",
    "s = input(\"enter the string\")\n",
    "\n",
    "hash = [0]*26\n",
    "for i in range(0,len(s)):\n",
    "    x =ord(s[i]) -  ord(\"a\")\n",
    "    hash[x] +=1\n",
    "\n",
    "q = int(input(\"enter the no of quaries\"))\n",
    "while(q>0):\n",
    "    n = ord(input(\"enter character\"))\n",
    "    m = n -ord(\"a\")\n",
    "    print(hash[m])\n",
    "    q = q-1"
   ]
  },
